# ── Supabase PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@db.supabase.co:5432/postgres

# ── Google AI Studio — free tier ─────────────────────────────────
GEMINI_API_KEY=your_key_here

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=generate_a_random_256_bit_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Local storage paths / Qdrant Cloud ────────────────────────────────
PDF_STORAGE_PATH=./data/pdfs
QDRANT_PATH=./data/qdrant
# For Qdrant Cloud:
# QDRANT_URL=https://your-cluster-url.aws.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key

# ── App ──────────────────────────────────────────────────────────
ENVIRONMENT=development
